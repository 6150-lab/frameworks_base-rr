<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/global_actions_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:gravity="center"
    android:layout_gravity="center">
  <com.android.systemui.globalactions.GlobalActionsLayoutLite
      android:id="@id/global_actions_view"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:focusable="false"
      android:orientation="vertical"
      android:clipChildren="false"
      android:clipToPadding="false"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      android:layout_weight="1">
    <com.android.systemui.common.ui.view.LaunchableConstraintLayout
        android:layout_width="@dimen/rr_power_panel_width"
        android:layout_height="wrap_content"
        android:id="@android:id/list"
        android:gravity="center"
        android:translationZ="@dimen/global_actions_translate"
        android:orientation="horizontal"
        android:background="@drawable/rr_power_panel_bg"
        android:padding="@dimen/rr_power_panel_padding"
        android:layoutDirection="ltr">

      <com.android.systemui.globalactions.GlobalActionsHeroView
          android:id="@+id/rr_power_hero"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:background="@drawable/rr_power_hero_bg"
          android:layoutDirection="locale"
          android:orientation="vertical"
          android:paddingHorizontal="14dp"
          android:paddingTop="18dp"
          android:paddingBottom="14dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

          <FrameLayout
              android:layout_width="46dp"
              android:layout_height="46dp">

            <ImageView
                android:id="@+id/rr_power_mark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rr_power_hero_chip"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/rr_power_mark" />

            <ImageButton
                android:id="@+id/rr_power_back"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rr_power_hero_chip"
                android:contentDescription="@string/rr_power_back"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />
          </FrameLayout>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="12dp"
              android:layout_weight="1"
              android:orientation="vertical">

            <TextView
                android:id="@+id/rr_power_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/rr_power_title"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/rr_power_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#BDFFFFFF"
                android:textSize="13sp" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rr_power_buttons"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

          <LinearLayout
              android:id="@+id/rr_power_off"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:background="@drawable/rr_power_btn_primary"
              android:focusable="true"
              android:gravity="center"
              android:orientation="horizontal"
              android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/rr_power_off_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:tint="@android:color/system_accent1_800" />

            <TextView
                android:id="@+id/rr_power_off_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:text="@*android:string/global_action_power_off"
                android:textColor="@android:color/system_accent1_800"
                android:textSize="15sp" />
          </LinearLayout>

          <Space
              android:id="@+id/rr_power_buttons_gap"
              android:layout_width="@dimen/rr_power_gap"
              android:layout_height="match_parent" />

          <LinearLayout
              android:id="@+id/rr_power_restart"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:background="@drawable/rr_power_btn_secondary"
              android:focusable="true"
              android:gravity="center"
              android:orientation="horizontal"
              android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/rr_power_restart_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/rr_power_restart_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:text="@*android:string/global_action_restart"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/rr_power_restart_more"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="#B3FFFFFF" />
          </LinearLayout>
        </LinearLayout>
      </com.android.systemui.globalactions.GlobalActionsHeroView>

      <androidx.constraintlayout.helper.widget.Flow
          android:id="@+id/list_flow"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/rr_power_gap"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@id/rr_power_hero"
          app:flow_wrapMode="chain"
          app:flow_maxElementsWrap="2"
          app:flow_horizontalGap="@dimen/rr_power_gap"
          app:flow_verticalGap="@dimen/rr_power_gap"
          app:flow_horizontalStyle="packed"
          app:flow_horizontalBias="0"/>
    </com.android.systemui.common.ui.view.LaunchableConstraintLayout>
  </com.android.systemui.globalactions.GlobalActionsLayoutLite>
</androidx.constraintlayout.widget.ConstraintLayout>
