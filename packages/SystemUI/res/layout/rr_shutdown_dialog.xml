<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rr_shutdown_glow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <FrameLayout
            android:layout_width="148dp"
            android:layout_height="148dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/rr_shutdown_track" />

            <ProgressBar
                android:id="@android:id/progress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminateDrawable="@drawable/rr_shutdown_ring"
                android:indeterminateDuration="3300" />

            <ImageView
                android:layout_width="70dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/rr_power_mark" />
        </FrameLayout>

        <TextView
            android:id="@android:id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@android:id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/rr_shutdown_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/rr_shutdown_back_soon"
            android:textColor="#A8FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
