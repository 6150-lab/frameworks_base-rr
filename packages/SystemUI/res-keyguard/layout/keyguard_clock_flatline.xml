<!-- Flatline: thin time, the date, and RR's heartbeat line with its readout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">
    <TextClock
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-light"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="84dp" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:alpha="0.8"
            android:textSize="15dp" />
        <TextView
            android:id="@+id/weather_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.8"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:includeFontPadding="false"
            android:text="&#183;"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            android:visibility="gone" />
        <com.android.systemui.weather.WeatherImageView
            android:id="@+id/weather_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
        <com.android.systemui.weather.WeatherTextView
            android:id="@+id/weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:alpha="0.8"
            android:fontFamily="@*android:string/config_clockFontFamily"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="15dp"
            android:visibility="gone"
            app:weatherLinkedView="@id/weather_separator"
            app:weatherText="temp" />
    </LinearLayout>
    <com.android.systemui.clocks.FlatlineClockView
        android:id="@+id/flatline"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="8dp" />
</LinearLayout>
