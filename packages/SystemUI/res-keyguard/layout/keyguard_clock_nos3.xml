<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clock_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center" >

    <!-- Date display -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:gravity="center"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="22dp" />
        <TextView
            android:id="@+id/weather_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="&#183;"
            android:textColor="@android:color/white"
            android:textSize="22dp"
            android:visibility="gone" />
        <com.android.systemui.weather.WeatherImageView
            android:id="@+id/weather_image"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:visibility="gone" />
        <com.android.systemui.weather.WeatherTextView
            android:id="@+id/weather_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="22dp"
            android:visibility="gone"
            app:weatherLinkedView="@id/weather_separator"
            app:weatherText="temp" />
    </LinearLayout>

    <!-- Rectangular Analog Clock -->
    <com.android.systemui.clocks.NothingAnalogClockView
        android:id="@+id/analog_clock"
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:layout_gravity="center" />
</LinearLayout>
