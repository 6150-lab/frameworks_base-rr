<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">Գրպանի ռեժիմը ակտիվ է</string>
    <string name="pocket_mode_illustration_description">Հեռախոսը գրպանում պատկերող նկար</string>
    <string name="pocket_mode_instructions_header">Հեռախոսն օգտագործելու համար՝</string>
    <string name="pocket_mode_instruction_step1">1. Համոզվիր, որ վերևում ցուցադրված կապույտ տարածքը (մոտության սենսորը) ազատ է և մաքուր է փոշուց ու կեղտից։</string>
    <string name="pocket_mode_instruction_step2">2. Սեղմիր և պահիր սնուցման կոճակը՝ գրպանի ռեժիմից դուրս գալու համար։</string>
</resources>
