<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">ჯიბის რეჟიმი ჩართულია</string>
    <string name="pocket_mode_illustration_description">ტელეფონის ილუსტრაცია ჯიბეში</string>
    <string name="pocket_mode_instructions_header">ტელეფონის გამოსაყენებლად:</string>
    <string name="pocket_mode_instruction_step1">1. დარწმუნდი, რომ ზემოთ ნაჩვენები ლურჯი არე (სიახლოვის სენსორი) დაფარული არ არის და სუფთაა.</string>
    <string name="pocket_mode_instruction_step2">2. ჯიბის რეჟიმიდან გასასვლელად დააჭირე და ხანგრძლივად დაიჭირე ჩართვის ღილაკი.</string>
</resources>
