<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">የኪስ ሁነታ ንቁ ነው</string>
    <string name="pocket_mode_illustration_description">ስልክ በኪስ ውስጥ ያለ ምስል</string>
    <string name="pocket_mode_instructions_header">ስልክዎን ለመጠቀም:</string>
    <string name="pocket_mode_instruction_step1">1. ከላይ የሚታየው ሰማያዊ ቦታ (ቅርበት ዳሳሽ) ያልተዘጋ እና ከቆሻሻ ወይም አቧራ የጸዳ መሆኑን ያረጋግጡ።</string>
    <string name="pocket_mode_instruction_step2">2. ከኪስ ሁነታ ለመውጣት የኃይል ቁልፉን ተጭነው ይያዙ።</string>
</resources>
