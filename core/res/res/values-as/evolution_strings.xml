<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">পকেট মোড সক্ৰিয়</string>
    <string name="pocket_mode_illustration_description">পকেটত থকা ফ’নৰ চিত্ৰ</string>
    <string name="pocket_mode_instructions_header">আপোনাৰ ফ’ন ব্যৱহাৰ কৰিবলৈ:</string>
    <string name="pocket_mode_instruction_step1">1. ওপৰত দেখুওৱা নীলা অঞ্চল (সমীপৱৰ্তী সংবেদক) বাধামুক্ত আৰু ধূলি-মাটি মুক্ত হোৱাটো নিশ্চিত কৰক।</string>
    <string name="pocket_mode_instruction_step2">2. পকেট মোডৰ পৰা ওলাই যাবলৈ পাৱাৰ বুটাম কিছুসময় চাপি ৰাখক।</string>
</resources>
