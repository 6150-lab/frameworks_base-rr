<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">حالت جیب فعال است</string>
    <string name="pocket_mode_illustration_description">تصویر گوشی در جیب</string>
    <string name="pocket_mode_instructions_header">برای استفاده از تلفن‌تان:</string>
    <string name="pocket_mode_instruction_step1">1. مطمئن شوید که ناحیه آبی (حسگر مجاورت) نشان داده شده در بالا بدون مانع و عاری از خاک یا گرد و غبار است.</string>
    <string name="pocket_mode_instruction_step2">2. دکمه نیرو را فشار داده و نگه دارید تا از حالت جیبی خارج شوید.</string>
</resources>
