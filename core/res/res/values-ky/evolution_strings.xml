<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">Чөнтөк режими иштеп турат</string>
    <string name="pocket_mode_illustration_description">Телефондун чөнтөктө турганынын иллюстрациясы</string>
    <string name="pocket_mode_instructions_header">Телефонуңузду колдонуу үчүн:</string>
    <string name="pocket_mode_instruction_step1">1. Жогоруда көрсөтүлгөн көк аймак (жакындык сенсору) тосулбаганын жана кир же чаңсыз экенин текшериңиз.</string>
    <string name="pocket_mode_instruction_step2">2. Чөнтөк режиминен чыгуу үчүн кубат баскычын басып туруңуз.</string>
</resources>
