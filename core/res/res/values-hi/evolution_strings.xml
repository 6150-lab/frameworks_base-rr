<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">पॉकेट मोड सक्रिय है</string>
    <string name="pocket_mode_illustration_description">जेब में फ़ोन का चित्र</string>
    <string name="pocket_mode_instructions_header">फ़ोन इस्तेमाल करने के लिए:</string>
    <string name="pocket_mode_instruction_step1">1. ऊपर दिखाए गए नीले क्षेत्र (प्रॉक्सिमिटी सेंसर) को ढका न रखें और उस पर धूल या गंदगी न हो, यह सुनिश्चित करें।</string>
    <string name="pocket_mode_instruction_step2">2. पॉकेट मोड से बाहर निकलने के लिए पावर बटन दबाकर रखें।</string>
</resources>
