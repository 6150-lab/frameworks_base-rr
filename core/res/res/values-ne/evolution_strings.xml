    <string name="pocket_mode_title">पकेट मोड सक्रिय छ</string>
    <string name="pocket_mode_illustration_description">पकेटमा फोनको चित्र</string>
    <string name="pocket_mode_instructions_header">फोन प्रयोग गर्न:</string>
    <string name="pocket_mode_instruction_step1">1. माथि देखाइएको नीलो क्षेत्र (नजिकता सेन्सर) अवरोधरहित र धुलो-माटोबाट मुक्त रहेको सुनिश्चित गर्नुहोस्।</string>
    <string name="pocket_mode_instruction_step2">2. पकेट मोडबाट बाहिर निस्कन पावर बटन थिची राख्नुहोस्।</string>
