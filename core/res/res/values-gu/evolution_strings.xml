<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="pocket_mode_title">પૉકેટ મોડ સક્રિય છે</string>
    <string name="pocket_mode_illustration_description">ખિસ્સામાં ફોનનું ચિત્ર</string>
    <string name="pocket_mode_instructions_header">તમારો ફોન વાપરવા માટે:</string>
    <string name="pocket_mode_instruction_step1">1. ઉપર બતાવેલ વાદળી વિસ્તાર (પ્રોક્સિમિટી સેન્સર) અવરોધ વગરનો અને ધૂળ કે મેલથી મુક્ત હોવો જોઈએ.</string>
    <string name="pocket_mode_instruction_step2">2. પૉકેટ મોડ બંધ કરવા માટે પાવર બટન દબાવી રાખો.</string>
</resources>
