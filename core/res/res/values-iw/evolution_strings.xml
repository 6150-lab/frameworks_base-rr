    <string name="pocket_mode_title">מצב כיס פעיל</string>
    <string name="pocket_mode_illustration_description">איור של טלפון בכיס</string>
    <string name="pocket_mode_instructions_header">כדי להשתמש בטלפון:</string>
    <string name="pocket_mode_instruction_step1">1. ודא שהאזור הכחול (חיישן הקרבה) שמוצג למעלה אינו חסום ונקי מלכלוך או אבק.</string>
    <string name="pocket_mode_instruction_step2">2. לחץ והחזק את כפתור ההפעלה כדי לצאת ממצב כיס.</string>
</resources>
